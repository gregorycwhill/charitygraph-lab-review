    {
      "concept_id": "cg-native:grant-and-sponsorship-funding-process",
      "preferred_label": "Grant and sponsorship funding process",
      "definition": "The organised process through which funding applications are received, assessed, approved, administered or disbursed for projects or programs.",
      "inclusion_boundary": "Includes funding rounds, online applications, advisory assessment, grants-management platforms, sponsorship processes and fund disbursement governance.",
      "exclusion_boundary": "Excludes fundraising by donors, the funded project’s delivery activities, and financial expenditure after funding is disbursed.",
