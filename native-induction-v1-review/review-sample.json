      "concept_id": "cg-native:regional-capability-development",
      "preferred_label": "Regional capability development",
      "definition": "Activities intended to strengthen skills, leadership, business capability, networks, innovation or productive capacity within regional communities or economies.",
      "inclusion_boundary": "Includes mentoring, workshops, business networking, leadership development, innovation initiatives and support for regional businesses or industries.",
      "exclusion_boundary": "Excludes general grant administration, standalone fundraising, and claims of improved economic conditions unless separately evidenced as outcomes.",
