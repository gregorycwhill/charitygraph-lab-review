    {
      "concept_id": "cg-native:monitoring-and-evaluation-practice",
      "preferred_label": "Monitoring and evaluation practice",
      "definition": "An organisation’s stated or documented practice of reviewing activities or projects against plans, identifying what is working, and assessing outcomes or impact.",
      "inclusion_boundary": "Includes monitoring, evaluation points in project lifecycles, performance review, milestone assessment and impact-target assessment.",
      "exclusion_boundary": "Excludes the underlying activity or output being evaluated and does not imply that evaluation findings establish effectiveness.",
      "supporting_observation_ids": [
        "nativeobs:b0006ddad0fd000b24f3d02755e5c165febe5412d8308611",
        "nativeobs:2e2446bd6daf96d402178621b41e31ca132ad8b9687cafb6",
        "nativeobs:f4f3673d06e54d9f83924367b8c77917dcade0c56ba1181a"
      ],
      "organisations": [
        "The Fred Hollows Foundation",
        "Local Buying Foundation (WA)",
        "World Vision Australia"
      ],
      "parent_concept_candidate": null,
      "confidence_statement": "High confidence: evaluation or milestone-review practice recurs, while effectiveness is not inferred."
    },
    {
      "concept_id": "cg-native:fundraising-channel",
      "preferred_label": "Fundraising channel",
      "definition": "A distinct mechanism or pathway used to solicit or receive donations, sponsorships, bequests or other fundraising support.",
      "inclusion_boundary": "Includes regular giving, public events, direct mail, corporate or trust donations, online fundraising, sponsorship and gifts in wills.",
      "exclusion_boundary": "Excludes expenditure of raised funds, grantmaking from funds, and general donor-support services unless a solicitation mechanism is specified.",
